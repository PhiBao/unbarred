# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# --- Unbarred audit engine ---
# Local default: http://127.0.0.1:8787
UNBARRED_ENGINE_URL=http://127.0.0.1:8787
# Shared bearer secret. Set the same value on the engine process.
UNBARRED_ENGINE_SECRET=devsecret
# Development only: lets the engine audit the locally served /fixture/.
# The engine reads this, not the app. NEVER set it in production.
# ALLOW_PRIVATE_URLS=1

# --- Agent chat (optional) ---
# The deterministic audit loop works without an LLM key.
# Any OpenAI-compatible gateway works:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# AGENT_ENGINE=ai-sdk:openai
# Or use Anthropic directly:
# ANTHROPIC_API_KEY=
# AGENT_ENGINE=anthropic

# --- Production ---
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
